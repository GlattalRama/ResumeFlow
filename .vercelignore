# When this file exists the Vercel CLI uses it INSTEAD of .gitignore to
# decide what to upload, so it must cover everything .gitignore does too.
# Motivation: the CLI doesn't read nested .gitignore files, so the Capacitor
# iOS/Android build trees (ios/App/build is >100 MB) were being uploaded and
# tripping Vercel's per-file size limit.
.git
node_modules
.next
out
build
*.tsbuildinfo
.DS_Store
.env
.env*.local
data
.vercel
.vscode
.idea
.logs

# Native mobile shells — not part of the web build
ios
android
mobile-shell
play-store-assets
*.jks
*.keystore
